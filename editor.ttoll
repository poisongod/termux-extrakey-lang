(* editor.ttoll — ttoll 编辑器行为规则 *)
(* K = ESC | ALT | CTRL | SPACE | ENTER ; D = UP | DOWN | LEFT | RIGHT *)
(* 文法词汇仅 K ∪ D 共 9 键; 和弦 x 也必须是文法键 (如 ALT+LEFT) *)
(* Ctrl+C 退出等系统级快捷由输入层硬编码, 不经 ttoll *)

(* ── 0x01 Normal: 光标/模式带入 ── *)
0x01,UP>0x04
0x01,DOWN>0x03
0x01,LEFT>0x01
0x01,RIGHT>0x02
0x01,ENTER>0x07
0x01,SPACE>0x08
0x01,ESC>0x00

(* ── 0x01 扩展 (合法和弦, 尾键须属 K ∪ D) ── *)
0x01,CTRL+UP>0x05
0x01,CTRL+DOWN>0x06
0x01,ALT+ENTER>0x12
0x01,ALT+SPACE>0x11
0x01,CTRL+ENTER>0x15
0x01,CTRL+ESC>0x17

(* ── 0x02 Insert: 字符内处理, ESC 退出 / Enter 换行 ── *)
0x02,ESC>0x09
0x02,ENTER>0x0B

(* ── 0x03 Command: 执行命令 / 放弃 ── *)
0x03,ESC>0x09
0x03,ENTER>0x13