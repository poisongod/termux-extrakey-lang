(* 原子按键：所有基础按键及自定义标识符 *)
N ::= "ESC" | "TAB" | "HOME" | "END" | "PGUP" | "PGDN" | "INS" | "DEL" | "BKSP"
    | "UP" | "LEFT" | "RIGHT" | "DOWN" | "ENTER"
    | "BACKSLASH" | "QUOTE" | "APOSTROPHE"
    | "F1" | "F2" | "F3" | "F4" | "F5" | "F6" | "F7" | "F8" | "F9" | "F10"
    | "F11" | "F12"
    | "KEYBOARD" | "DRAWER"
    | "SCROLL" | "SPACE"
    | [A-Za-z][A-Za-z0-9_]*

(* 特殊修饰键：四个特殊键，同一键盘中各自只能出现一次 *)
S ::= "CTRL" | "ALT" | "FN" | "SHIFT"

(* M：按键行配置 *)
M ::= N           (* 单键：普通键 *)
    | S           (* 单键：特殊修饰键 *)
    | N.S         (* 弹出键：普通键为主键，向上滑动弹出特殊键 *)
    | S.N         (* 弹出键：特殊键为主键，向上滑动弹出普通键 *)
    | N.N         (* 弹出键：普通键为主键，向上滑动弹出另一个普通键 *)
    | N(N)        (* 组合键：普通键（外部）作为修饰键，作用于内部的普通键 *)
    | N(S)        (* 组合键：普通键（外部）作为修饰键，作用于内部的特殊键 *)
    | S(N)        (* 组合键：特殊键（外部）作为修饰键，作用于内部的普通键（如 CTRL(C)） *)
    | N:N         (* 键名重命名：普通键值（冒号左）显示为自定义名称（冒号右） *)
    | S:N         (* 键名重命名：特殊键值（冒号左）显示为自定义名称（冒号右） *)
    | M M         (* 空格序列：在同一键盘行中连接多个键定义 *)
    | M'\n'       (* 代码换行：文件中的物理换行，不影响键盘行分组 *)
    | M';\n'      (* 分号换行：强制结束当前键盘行，开始一个新的键盘行 *)
