(* tekl; `A` `N` = placeholder, "" = literal *)

N ::= "ESC" | "TAB" | "HOME" | "END" | "PGUP" | "PGDN"
    | "INS" | "DEL" | "BKSP" | "UP" | "LEFT" | "RIGHT"
    | "DOWN" | "ENTER" | "BACKSLASH" | "QUOTE" | "APOSTROPHE"
    | "F1" | "F2" | "F3" | "F4" | "F5" | "F6" | "F7"
    | "F8" | "F9" | "F10" | "F11" | "F12"
    | "KEYBOARD" | "DRAWER" | "SCROLL" | "SPACE"
    | '"' , { [^\n] } , '"'
    | "'" , { [^\n] } , "'";

S ::= "CTRL" | "ALT" | "FN" | "SHIFT";

A ::= N           (* A *)
    | S           (* S *)
    | A(A)        (* {macro: "A A"} *)
    | A:N         (* {key: A, display: N} *)

M ::= A           (* A *)
    | A.A         (* {key: A, popup: A} *)
    | M M         (* [A, A] *)
    | M'\n'       (* \n *)
    | M';\n'      (* M],' \ \n'[ *)