(* 原子按键 *)
N ::= "ESC" | "TAB" | "HOME" | "END" | "PGUP" | "PGDN" | "INS" | "DEL" | "BKSP"
    | "UP" | "LEFT" | "RIGHT" | "DOWN" | "ENTER"
    | "BACKSLASH" | "QUOTE" | "APOSTROPHE"
    | "F1" | "F2" | "F3" | "F4" | "F5" | "F6" | "F7" | "F8" | "F9" | "F10"
    | "F11" | "F12"
    | "KEYBOARD" | "DRAWER"
    | "SCROLL" | "SPACE"
    | [A-Za-z0-9_-]*

(* 特殊修饰键 *)
S ::= "CTRL" | "ALT" | "FN" | "SHIFT"

(* 原子配置项 *)
A ::= N           (* 普通单键 *)
    | S           (* 特殊单键 *)
    | A(A)        (* 组合键：外部 A 修饰内部 A *)
    | A:N         (* 键名重命名：A 显示为自定义文本 N *)

(* 配置行 *)
M ::= A           (* 单键 *)
    | A.A         (* 弹出键：A 为主键，向上滑动弹出 A *)
    | M M         (* 空格序列 *)
    | M'\n'       (* 代码换行 *)
    | M';\n'      (* 分号换行：键盘行分隔 *)
