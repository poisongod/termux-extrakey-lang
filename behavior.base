(* tekl.ttoll — TUI action rules *)
(* K = ESC | ALT | CTRL | SPACE | ENTER *)
(* D = UP | DOWN | LEFT | RIGHT *)
(* M = 0x01 | 0x02 | 0x03 *)

(* ── 全局规则 (任何模式生效) ── *)
CTRL+C>0x00
CTRL+S>0x41

(* ── Mode 0x01: 键盘浏览 ── *)
0x01,ESC>0x00
0x01,UP>0x10
0x01,DOWN>0x11
0x01,LEFT>0x12
0x01,RIGHT>0x13
0x01,ENTER>0x02
0x01,SPACE>0x30

(* ── Mode 0x02: 主键编辑 ── *)
0x02,ESC>0x01
0x02,ENTER>0x04

(* ── Mode 0x03: 弹出键编辑 ── *)
0x03,ESC>0x01
0x03,ENTER>0x04
