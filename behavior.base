(* 非终结符: M, P, G, K, D, C — 文法见 docs/ttoll.ebnf *)
(* 动作 id 与行为段 @ 定义一一对应; 语义无歧义, 同 id 恒同行为。 *)
(* 规则段声明"谁触发谁", 行为段声明"动作做什么" — 运行时由解释器按程序驱动。 *)

(* ── 规则段 ───────────────────────────────────────────────────────── *)

(* M0 键盘编辑 · 无面板 *)
0.-.UP>移动焦点
0.-.DOWN>移动焦点
0.-.LEFT>移动焦点
0.-.RIGHT>移动焦点
0.-.SPACE?nosel>选中焦点键位
0.-.SPACE?same>取消选中焦点键位
0.-.SPACE?diff>交换焦点键位并实时更新
0.-.CTRL?sel>弹出焦点键位行列操作矩阵菜单
0.-.ALT>1
0.-.ESC>退出程序

(* M0 行列菜单 (面板 R) *)
0.R.UP>移动上
0.R.DOWN>移动下
0.R.SPACE>执行
0.R.ESC>关闭面板

(* M1 主键编辑 · 无面板 *)
1.-.SPACE>打开预设键值矩阵
1.-.ENTER>编辑主键名称
1.-.ALT>2
1.-.ESC>返回键盘模式

(* M1 矩阵 (面板 M) *)
1.M.UP>移动焦点
1.M.DOWN>移动焦点
1.M.LEFT>移动焦点
1.M.RIGHT>移动焦点
1.M.CTRL?insel>取消选值
1.M.CTRL?noinsel>选中列表示选值
1.M.ESC>完成矩阵编辑

(* M1 名称框 (面板 N) *)
1.N.ENTER>应用
1.N.ESC>丢弃

(* M2 弹出键编辑 · 无面板 *)
2.-.SPACE>打开预设键值矩阵
2.-.ENTER>编辑弹出键名称
2.-.ALT>0
2.-.ESC>返回主键模式

(* M2 矩阵 (面板 M) *)
2.M.UP>移动焦点
2.M.DOWN>移动焦点
2.M.LEFT>移动焦点
2.M.RIGHT>移动焦点
2.M.CTRL?insel>取消选值
2.M.CTRL?noinsel>选中列表示选值
2.M.ESC>完成矩阵编辑

(* M2 名称框 (面板 N) *)
2.N.ENTER>应用
2.N.ESC>丢弃

(* ── 行为段 ───────────────────────────────────────────────────────── *)

@移动焦点
  move

@选中焦点键位
  sel

@取消选中焦点键位
  unsel

@交换焦点键位并实时更新
  swap

@弹出焦点键位行列操作矩阵菜单
  menu.open

@移动上
  move

@移动下
  move

@执行
  menu.exec

@关闭面板
  escpanel

@打开预设键值矩阵
  matrix.open

@选中列表示选值
  matrix.add

@取消选值
  matrix.del

@完成矩阵编辑
  matrix.finish

@编辑主键名称
  name.openMain

@编辑弹出键名称
  name.openPopup

@应用
  name.apply

@丢弃
  name.discard

@退出程序
  exit

@0
  mode 0

@1
  mode 1

@2
  mode 2

@返回键盘模式
  mode 0

@返回主键模式
  mode 1
