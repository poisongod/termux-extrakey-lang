# Termux Extra Key Language example
# EBNF: tekl.ebnf
#   A            plain key            -> "ESC"
#   A:B          rename label         -> {key, display: B}
#   A(B)         combo (nested ok)    -> {macro: "A B", display: "A B"}
#   A(B):Label   combo renamed        -> {macro: "A B", display: Label}
#   A.B          popup (A any atom)   -> {key: A, popup: B} / {macro: ..., popup: B}
#   ;            keyboard row separator, \n is just a code newline

ESC TAB CTRL ALT
  HOME UP END PGUP
  PGDN DOWN LEFT RIGHT
  DEL BKSP INS;
CTRL(C) ALT(A) FN(F) SHIFT(S)
  CTRL(A):toggle ALT(x)
  ESC.F1 HOME:Start TAB:Lbl
  CTRL(C).F5;
DRAWER KEYBOARD SCROLL SPACE ENTER
  BACKSLASH QUOTE APOSTROPHE
  F1 F2 F3 F4 F5 F6 F7 F8 F9 F10 F11 F12;