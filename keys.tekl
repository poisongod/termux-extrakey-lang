# Termux Extra Key Language example
# rows are separated by ';'
#   key            plain key           -> "ESC"
#   key.popup      advanced key        -> {key, popup}
#   MOD(key)       advanced key combo  -> {macro: "MOD key"}
#   key:Label      label/rename        -> {key, display}
#   k1 k2 :Label   macro               -> {macro: "k1 k2", display: "Label"}

ESC TAB CTRL ALT
  HOME UP END PGUP
  PGDN DOWN LEFT RIGHT
  DEL BKSP INS;
CTRL(C) ALT(A) FN(F) SHIFT(S)
  ESC.F1 CTRL.ALT HOME:Start TAB:Lbl
  CTRL f d:tmux exit
  ESC w:save file;
DRAWER KEYBOARD SCROLL SPACE ENTER
  BACKSLASH QUOTE APOSTROPHE
  F1 F2 F3 F4 F5 F6 F7 F8 F9 F10 F11 F12;
