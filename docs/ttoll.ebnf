(* 非终结符：K, D, M, S, A, C *)
K = 'ESC' | 'ALT' | 'CTRL' | 'SPACE' | 'ENTER'       (* 功能键 集 *)
D = 'UP' | 'DOWN' | 'LEFT' | 'RIGHT'                 (* 方向键 集 *)
M = '0' | '1' | '2'                                  (* 状态：0=键盘，1=主键，2=弹出键 *)
S = S , ',' , S | K'*' | D'*'                      (* 集单元: 逗号递归组合 或 键/方向键的重数 *)
A = S , '.' , A | S                                  (* 顺序序列: 点分隔的 集单元/键 *)
C = M'.'A'>'id"\n" | M'.'D'>'id"\n" | M'.'{S}'.'A'>'id"\n" | M'.'{S}'>'id"\n"  (* 操作规则 *)

(* 说明：与 tekl.ttoll 规则体对应:
   0.D>移动焦点                          ← C = M'.'{S}.'.A>id, S=D, 无尾段
   0.ALT>1                              ← C = M'.'{S}.'.A>id, 单键 S=ALT, id=1
   1.SPACE.{CTRL*,D*}.ESC>...           ← {S}=集合序列, A=尾段(ESC), 逗号递归组合
   注: S = S','S | K* | D*  —— 集合=逗号递归; * 只在端子 K/D 上 *)
(* 待澄清: 规则体中的花括号 {} 与 C 中 {S} 的对应关系 (字面集合 vs 重复) *)