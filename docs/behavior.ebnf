(* 非终结符：K, D, M, P, G, C, AC, S *)
K = 'ESC' | 'ALT' | 'CTRL' | 'SPACE' | 'ENTER'       (* 功能键 集 *)
D = 'UP' | 'DOWN' | 'LEFT' | 'RIGHT'                 (* 方向键 集 *)
M = '0' | '1' | '2'                                  (* 状态：0=键盘，1=主键，2=弹出键 *)
P = '-' | 'R' | 'M' | 'N'                            (* 面板：无 / 行列菜单 / 矩阵 / 名称框 *)
G = 'sel' | 'nosel' | 'same' | 'diff'
  | 'insel' | 'noinsel' | 'haspopup' | 'nopopup'     (* 内置守卫; 可经 registry.guard 扩展 *)
C = M , '.' , P , '.' , ( K | D ) , [ '?' , G ]* , '>' , id , "\n"   (* 操作规则; 守卫可链式 *)

(* 行为段：动作定义 = 动作 id 换行后跟语句行; 语句 = 内置操作 或 原语名 *)
AC = '@' , id , "\n" , { S , "\n" }                  (* 动作定义 *)
S = 'mode' , ' ' , N                                 (* 模式跳转 (0|1|2) *)
  | 'escpanel'                                       (* 关闭面板并清选中 *)
  | 'sel' | 'unsel'                                  (* 选中/取消选中 *)
  | 'apply' | 'cancel' | 'exit'                      (* 生效效果 *)
  | 'seterrors' , ' ' , str                          (* 写入错误提示 *)
  | prim                                             (* 原语调用: 原子变换 *)
  (* 内置原语: move / swap / menu.open / menu.exec / matrix.open / matrix.add /
     matrix.del / matrix.reset / matrix.finish / name.openMain / name.openPopup /
     name.apply / name.discard; 第三方插件可经 registerPrim 扩展 *)

(* 程序 = 规则段 + 行为段, 可混排; 行分类: '@' 开头 = 行为段头,
   '^[0-2]\.' 开头 = 规则行, 其余在行为段内 = 语句 (规则行可后置)。
   parseProgram 静态检查: 键/守卫/原语合法性 + 规则动作必须有行为段定义 + 模式可达。
   parseRules 只取规则 (行为段跳过)。

   语义:
   - 每条规则 = 模式 + 面板 + 单键(链式守卫) → 动作 id。
   - 同 (M, P, 键) 多条规则靠守卫区分; 运行时按声明序求守卫, 首条命中执行;
       无守卫 = 无条件命中。均不命中 = 无动作。
   - 守卫语义 (作用于当前 state):
     sel/nosel   : 已有/没有 选中格
     same/diff   : 选中格 == / != 光标 (且存在选中)
     insel/noinsel: 矩阵高亮格 已在 / 不在 已选序列
     haspopup/nopopup: 焦点键位 有 / 没有 弹出键
   - 动作 = 行为段声明的语句脚本 (内置操作 + 原语), 由 mode.mjs 解释器执行;
       显式注册的 JS 动作 (registerAction/wrapAction) 优先覆盖行为段。
     插件扩展: registerActionWithRules (行为+键位一次交付) / registerPrim /
     registerGuard / wrapAction, 均即时生效 (注销时重建 dispatch)。
   - 程序 = 基座 tekl.ttoll (规则+行为) + 各插件贡献的 rules (按依赖序拼接)。
   - 面板 M 与 N 的键位是显式的 (逐键枚举), 不再用 {K*,D*} 集合描述。
*)
