(* 非终结符：K, D, M, S, A, C *)
K = 'ESC' | 'ALT' | 'CTRL' | 'SPACE' | 'ENTER'      (* 功能键 集 *)
D = 'UP' | 'DOWN' | 'LEFT' | 'RIGHT'                (* 方向键 集 *)
M = '0' | '1' | '2'                                 (* 状态：0=键盘，1=主键，2=弹出键 *)
S = S , ',' , S | K'*' | D'*'                        (* 集单元: 逗号组合(递归) 或 键/方向键任意多次 *)
A = S , '.' , A | S                                  (* 顺序序列: 点分隔的 集单元/键 *)
C = M'.'A'>'id | M'.'D'>'id | M'.'{S}'.'A'>'id | M'.'{S}'>'id   (* 操作规则 *)

0.ESC>更新Termux实际键盘并退出TUI
0.D>移动焦点
0.SPACE>选中焦点键位
0.CTRL>弹出焦点键位行列操作矩阵菜单
0.SPACE.{D*}.SPACE>交换焦点键位并实时更新
0.ALT>1

1.ESC>更新Termux实际键盘并返回0
1.D>移动焦点
1.ENTER>编辑焦点键位主键名称
1.SPACE>弹出焦点键位预设键值矩阵菜单
1.SPACE.{CTRL*,D*}.ESC>D移动焦点，CTRL选择组合键，ESC实时更新并回退到1
1.SPACE.ALT>2

2.ESC>更新Termux实际键盘并返回1
2.D>移动焦点
2.ENTER>编辑焦点键位弹出键名称
2.SPACE>弹出焦点键位预设键值矩阵菜单
2.SPACE.{CTRL*,UP*}.ESC>D移动焦点,CTRL选择组合键,ESC实时更新并回退到2
