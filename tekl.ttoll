(* tekl.ttoll — TUI action rules *)
(* K = ESC | ALT | CTRL | SPACE | ENTER *)
(* D = UP | DOWN | LEFT | RIGHT *)
(* M = 0x01 | 0x02 | 0x03 *)
(* Ctrl+C 退出 / Ctrl+S 保存 由输入层硬编码, 不经 ttoll *)

(* ── Mode 0x01: 键盘浏览 ── *)
0x01,ESC>0x00
0x01,UP>0x10
0x01,DOWN>0x11
0x01,LEFT>0x12
0x01,RIGHT>0x13
0x01,ENTER>0x02
0x01,SPACE>0x30
0x01,CTRL+SPACE>0x40

(* ── Mode 0x02: 主键编辑 ── *)
0x02,ESC>0x01
0x02,ENTER>0x04

(* ── Mode 0x03: 弹出键编辑 ── *)
0x03,ESC>0x01
0x03,ENTER>0x04
