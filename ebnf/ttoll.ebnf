Tekl Tui Operational logic Language (ttoll)

(* 非终结符：K, D, ID, M, C, R, P *)
K = 'ESC' | 'ALT' | 'CTRL' | 'SPACE' | 'ENTER'   
D = 'UP' | 'DOWN' | 'LEFT' | 'RIGHT'             
M = '0x01' | '0x02' | '0x03'                     
ID = M | /0x[0-9A-Fa-f]{2}/                      
C = K ',' C | K | '{' C '}'                      
R = M ',' C '>' ID                                
  | M ',' D '>' ID                                
  | C '>' ID                                      
  | D '>' ID                                      
P = { R '\n' }                                    
