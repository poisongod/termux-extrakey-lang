Tekl Tui Operational logic Language (ttoll)
EBNF Standard: ISO/IEC 14977

(* 两个 TUI 共用这一份文法：~/.termux/tekl.ttoll（布局 TUI）与
   ~/.termux/editor.ttoll（行为编辑器）。二者只差 ID 注册表与模式语义：
   布局 TUI 的 0x01/0x02/0x03 = Normal/Edit/Popup，
   编辑器的 0x01/0x02/0x03 = Normal/Insert/Command。 *)

(* ── 行式语法约定 ───────────────────────────────────────────────────
   - 一行最多一条规则；行首与行尾的空白会被去掉。
   - 文件中的空行、以 '(*' 开头的行，以及形如 'K = …' / 'D = …' 的文法
     标题行整行忽略。没有真正的块注释：只有行首 '(*' 才跳过，
     'ESC>0x01 (* note *)' 中的注释会并入动作串。
   - 没有 '>' 的行被静默忽略（不报错）。
   - LHS 的每个步骤、模式前缀、和弦各部分与 '{}' 集合内各项都会被 trim：
     '0x01 , ESC'、'ESC > 0x01'、'CTRL + SPACE' 均合法。模式前缀仍必须写成
     '0xHH,'（逗号前可有空白，逗号后接步骤）。
   - 文法错误返回带行号的 Err，不 panic。
   - 逗号分隔的空步骤（首尾逗号、连续逗号）会被忽略。
   ────────────────────────────────────────────────────────────────── *)

(* 模式号；只允许 0x01、0x02、0x03。 *)
M = '0x01' | '0x02' | '0x03' ;

(* 键词汇冻结为 K ∪ D 共 9 个键名。 *)
K = 'ESC' | 'ALT' | 'CTRL' | 'SPACE' | 'ENTER' ;
D = 'UP' | 'DOWN' | 'LEFT' | 'RIGHT' ;

(* K/D 同时是集合非终结符：在规则中单独出现（如 'K>0x01'）表示整组按键；
   出现在 '{}' 内时等价于把整组成员都列入集合。 *)
Key = K | D ;

(* 和弦：'CTRL+SPACE'、'ALT+LEFT'。每一段都必须是 Key，且不能带 '*'。 *)
Chord = Key { '+' Key } ;

(* 步骤：单键（可带 '*'）、和弦、或按键集合 '{}'。 *)
Step = Key [ '*' ]
     | Chord
     | '{' SetItem { ',' SetItem } '}' ;
SetItem = Key | Chord ;

(* 规则：可选模式前缀 + 逗号分隔的步骤序列 > 非空动作串。
   动作串取 '>' 之后的整行内容（两端去空白），可以再包含 '>'；
   它通常形如 '0x10'，但词法上不限于十六进制，由 ID 注册表校验。 *)
Lhs = [ M ',' ] Step { ',' Step } ;
Rule = Lhs '>' ? 非空的动作串（到行尾） ? ;

(* 文件：逐行匹配规则或被忽略的行。 *)
P = { Rule | ? 空行 / 注释行 / 文法标题行 / 无 '>' 的行 ? } ;
