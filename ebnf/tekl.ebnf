Termux Extra key Language (tekl)
EBNF Standard: ISO/IEC 14977

(* ── 词法约定 ───────────────────────────────────────────────────────
   - 空白：空格、制表符、回车、换行。'#' 到行尾是注释，注释等价于空白。
   - 换行不是语句分隔符：一行或连续多行属于同一个键盘行，键盘行只在
     ';' 或文件末尾结束。
   - 空白与注释可以出现在任意 token 之间（LITERAL 内部除外）。
   - 键名与全局设置名匹配不区分大小写（'esc' 等同 'ESC'）。
   - '=' 之后的纯数字串按 NUMBER 处理，其他位置的数字串是 IDENT。
   - height/theme/layout/reload 在矩阵顶层作为独立项时是保留字（会被解析为 G），
     不能直接用作键名；出现在组合或标签位置时按普通 IDENT 处理。
   ────────────────────────────────────────────────────────────────── *)

(* N：已识别的按键名；S：修饰键名。二者都只是 IDENT 的特例，
   其余任意 IDENT 也会被接受并按原样作为字面键保留。 *)
N = 'ESC'
  | 'TAB'
  | 'HOME'
  | 'END'
  | 'PGUP'
  | 'PGDN'
  | 'INS'
  | 'DEL'
  | 'BKSP'
  | 'UP'
  | 'LEFT'
  | 'RIGHT'
  | 'DOWN'
  | 'ENTER'
  | 'BACKSLASH'
  | 'QUOTE'
  | 'APOSTROPHE'
  | 'F1'
  | 'F2'
  | 'F3'
  | 'F4'
  | 'F5'
  | 'F6'
  | 'F7'
  | 'F8'
  | 'F9'
  | 'F10'
  | 'F11'
  | 'F12'
  | 'KEYBOARD'
  | 'DRAWER'
  | 'SCROLL'
  | 'SPACE'
  | 'PASTE' ;

S = 'CTRL' | 'ALT' | 'FN' | 'SHIFT' ;

DIGIT = ? ASCII '0'..'9' ? ;
LETTER = ? ASCII 'A'..'Z' or 'a'..'z' ? ;

IDENT = ( LETTER | DIGIT | '_' ) { LETTER | DIGIT | '_' } ;
NUMBER = DIGIT { DIGIT } ;   (* 须在 64 位有符号整数范围内 *)

LITERAL = '"' { ? 除 '"' 与换行外的任意字符 ? } '"'
        | "'" { ? 除 "'" 与换行外的任意字符 ? } "'" ;
(* LITERAL 不跨行、不支持转义，可以是空串（会有警告）。 *)

(* 按键动作：基础键后跟任意多个组合或标签。
   标签必须是不带引号的 IDENT；省略标签（如 'ESC:'）也合法，但会产生警告。 *)
A = ( N | S | IDENT | LITERAL )
    { '(' A ')' | ':' [ IDENT ] } ;

(* 矩阵项：A 或弹出键 A.A。弹出项内部不能再是弹出键。 *)
M = A [ '.' A ] ;

(* Termux 全局配置。Termux App 只读取矩阵，这些行会被忽略；
   CLI/TUI 接受并在存盘时保留。 *)
G = 'height' '=' NUMBER
  | 'theme' '=' IDENT
  | 'layout' '=' IDENT
  | 'reload' ;

(* 键盘行：矩阵项之间可以夹全局设置，G 不结束当前行。
   末尾的 ';' 可省略（仅限最后一行）；空语句 ';' 被忽略。 *)
Row = M { G | M } ';' ;

P = { G | ';' | Row } [ M { G | M } ] ;
