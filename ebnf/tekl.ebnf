Termux Extra key Language (tekl)
EBNF Standard: ISO/IEC 14977

(* N：按键名 *)
(* S：修饰键 *)
(* A：按键动作 *)
(* G：Termux 全局配置项 *)
(* M：键盘矩阵 *)
(* P：完整 tekl 文件 *)

N = 'ESC'
  | 'TAB'
  | 'HOME'
  | 'END'
  | 'PGUP'
  | 'PGDN'
  | 'INS'
  | 'DEL'
  | 'BKSP'
  | 'UP'
  | 'LEFT'
  | 'RIGHT'
  | 'DOWN'
  | 'ENTER'
  | 'BACKSLASH'
  | 'QUOTE'
  | 'APOSTROPHE'
  | 'F1'
  | 'F2'
  | 'F3'
  | 'F4'
  | 'F5'
  | 'F6'
  | 'F7'
  | 'F8'
  | 'F9'
  | 'F10'
  | 'F11'
  | 'F12'
  | 'KEYBOARD'
  | 'DRAWER'
  | 'SCROLL'
  | 'SPACE'
  | 'PASTE'
  | '"' { [^\n] } '"'
  | "'" { [^\n] } "'"

S = 'CTRL' | 'ALT' | 'FN' | 'SHIFT'

A = N
  | S
  | A '(' A ')'
  | A ':' N

G = 'height' '=' [0-9]+
  | 'theme' '=' IDENT
  | 'layout' '=' IDENT
  | 'reload'

(* 全局设置由 CLI/TUI 接受并保留；Termux App 只读取 M 矩阵，G 会被忽略。 *)

M = A
  | A '.' A
  | M M
  | M '\n'
  | M ';\n'

P = { G '\n' } { M }
